#!/usr/bin/env python3
"""Check known disclosure patterns; optionally stage a clean public source copy.

This is a conservative distribution inventory, not a secret-scanning guarantee.
Binary references require separate visual review and rights verification.
"""
import argparse
import re
import shutil
import sys
from pathlib import Path
from _repository import ROOT, DIRECTORIES, FILES, public_files, gitignore_content

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--list", action="store_true", help="Print selected source paths")
parser.add_argument("--copy-to", type=Path, help="Copy selected source to a new directory")
args = parser.parse_args()
files = list(public_files())
patterns = {
    "personal absolute path": re.compile(r"/(?:Users|Volumes)/[A-Za-z0-9_.-]+/"),
    "Apple device UDID": re.compile(r"\b[0-9A-Fa-f]{8}-[0-9A-Fa-f]{16}\b"),
    "private key material": re.compile(r"-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----"),
    "GitHub token": re.compile(r"\b(?:gh[pousr]_[A-Za-z0-9]{25,}|github_pat_[A-Za-z0-9_]{30,})\b"),
    "embedded signing team": re.compile(r"DEVELOPMENT_TEAM\s*=\s*[A-Z0-9]{10}\b"),
}
errors = []
if (ROOT / ".gitignore").read_text() != gitignore_content():
    errors.append("Git exclusions differ from the public inventory policy; run python3 scripts/_repository.py --write-gitignore")
selected = {str(path.relative_to(ROOT)) for path in files}
for command in ("apple/scripts/build", "apple/scripts/test", "apple/scripts/generate-project", "scripts/check"):
    if command not in selected:
        errors.append(f"Essential development command missing from public inventory: {command}")
local_root_entries = {".git", ".local", ".DS_Store", ".impeccable", "FitShowReferences", "build", "artifacts"}
for entry in ROOT.iterdir():
    if entry.name not in DIRECTORIES | FILES | local_root_entries:
        errors.append(f"Unclassified root entry requires distribution review: {entry.name}")
for path in files:
    if path.suffix == ".png" and path.name.startswith("Screenshot"):
        errors.append(f"{path.relative_to(ROOT)}: unreviewed original screenshot filename")
    try:
        text = path.read_text(encoding="utf-8")
    except (UnicodeDecodeError, ValueError):
        continue
    for label, pattern in patterns.items():
        if pattern.search(text):
            errors.append(f"{path.relative_to(ROOT)}: {label}")
# Reference images are private even when redacted. A clean checkout has no
# private originals or reference manifest; checks must not depend on either.
references = ROOT / "docs/references/fitshow"
if references.exists():
    for path in references.rglob("*"):
        if path.is_file() and path != references / "README.md":
            errors.append("Keep third-party reference assets and manifests under ignored .local/references, not docs/references/fitshow")
if errors:
    print("\n".join(errors), file=sys.stderr)
    sys.exit(1)
if args.list:
    print("\n".join(str(path.relative_to(ROOT)) for path in files))
if args.copy_to:
    destination = args.copy_to.expanduser().resolve()
    if destination.exists():
        parser.error("--copy-to requires a new, nonexistent directory")
    if destination == ROOT or ROOT in destination.parents:
        parser.error("Stage the public copy outside the source directory")
    destination.mkdir(parents=True)
    for path in files:
        target = destination / path.relative_to(ROOT)
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(path, target)
    print(f"Public source staged: {len(files)} files at {destination}")
else:
    print(f"Public inventory: {len(files)} files; known text disclosure patterns absent.")
