    "HealthKit conserva una sesión activa que no puede asociarse con seguridad a esta preparación fallida. Revísala en Salud; no se descartó ni se inició otra.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthKit conserva una sesión activa que no puede asociarse con seguridad a esta preparación fallida. Revísala en Salud; no se descartó ni se inició otra."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthKit has an active session that cannot be safely linked to this failed preparation. Review it in Health; no session was discarded or started."
          }
        }
      }
    },
