        }
      }
    },
    "Abre la app Watch de Apple en este iPhone y sigue sus instrucciones para añadir el reloj. Después vuelve aquí y comprueba la instalación de VAGANCIA FITNESS.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la app Watch de Apple en este iPhone y sigue sus instrucciones para añadir el reloj. Después vuelve aquí y comprueba la instalación de VAGANCIA FITNESS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Apple Watch app on this iPhone and follow its steps to add your watch. Then return here and check that VAGANCIA FITNESS is installed."
          }
        }
      }
    },
