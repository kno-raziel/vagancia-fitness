        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple solicita acceso por tipo de dato. Una lectura ausente no significa permiso denegado."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple requests access for each data type. A missing reading does not mean access was denied."
