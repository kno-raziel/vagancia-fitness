{
  "sourceLanguage": "es",
  "strings": {
    "background.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running your workout program"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecutando tu programa de entrenamiento"
          }
        }
      }
    },
    "bluetooth.phase.connecting": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectando…"
          }
        }
      }
    },
    "bluetooth.phase.disconnected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnected"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectado"
          }
        }
      }
    },
    "bluetooth.phase.disconnecting": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnecting…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectando…"
          }
        }
      }
    },
    "bluetooth.phase.discovering": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discovering services…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explorando servicios…"
          }
        }
      }
    },
    "bluetooth.phase.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection failed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se completó la conexión"
          }
        }
      }
    },
    "bluetooth.phase.idle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready to scan"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo para buscar"
          }
        }
      }
    },
    "bluetooth.phase.ready": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado"
          }
        }
      }
    },
    "bluetooth.phase.scanning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanning for devices…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscando dispositivos…"
          }
        }
      }
    },
    "control.accepted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: accepted by FTMS; check the treadmill response."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: aceptado por FTMS; comprueba la respuesta de la banda."
          }
        }
      }
    },
    "control.authorization": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The test requires an explicit operator action."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La prueba necesita una acción explícita del operador."
          }
        }
      }
    },
    "control.automaticSuspended": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The FTMS channel lost permission or became uncertain; automatic targets will not be sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El canal FTMS perdió permiso o quedó incierto; no se envían objetivos automáticos."
          }
        }
      }
    },
    "control.capabilityUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connected treadmill does not advertise FTMS control and speed range; the workout will not start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El equipo conectado no anuncia control y rango de velocidad FTMS; no se iniciará el entrenamiento."
          }
        }
      }
    },
    "control.connectFirst": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect the treadmill and prepare FTMS before starting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta la caminadora y prepara FTMS antes de iniciar."
          }
        }
      }
    },
    "control.disableMockScan": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off demo mode to scan for Bluetooth devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva el modo de demostración para buscar Bluetooth."
          }
        }
      }
    },
    "control.disconnected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Control disconnected. Earlier results are historical."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Control desconectado. Los resultados anteriores son históricos."
          }
        }
      }
    },
    "control.failSuffix": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " It will not be resent; use the physical controls and reconnect to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " No se reenvía; usa los controles físicos y reconecta para continuar."
          }
        }
      }
    },
    "control.inclineOutOfRange": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Incline is outside the allowed range."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La inclinación está fuera del rango permitido."
          }
        }
      }
    },
    "control.inclineRange": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Target is outside the advertised incline range, or no range is available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Objetivo fuera del rango de inclinación anunciado o rango no disponible."
          }
        }
      }
    },
    "control.inclineRecent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for a recent nonzero speed reading before changing incline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera velocidad reciente en movimiento antes de cambiar la inclinación."
          }
        }
      }
    },
    "control.inclineUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Incline is unavailable in this session; speed continues."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La inclinación no está disponible en esta sesión; la velocidad continúa."
          }
        }
      }
    },
    "control.increment": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The target must follow the advertised increment; it will not be rounded silently."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El objetivo debe respetar el incremento anunciado; no se redondea silenciosamente."
          }
        }
      }
    },
    "control.indications": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare FTMS indications first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero prepara las indicaciones FTMS."
          }
        }
      }
    },
    "control.interrupted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection ended with a procedure pending."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión se interrumpió con un procedimiento pendiente."
          }
        }
      }
    },
    "control.invalidResponse": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid FTMS response. Its bytes were retained."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respuesta FTMS inválida. Se conservaron sus bytes."
          }
        }
      }
    },
    "control.lateWriteError": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The BLE write reported an error after the FTMS response was received: %@. The protocol response was retained."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La escritura BLE informó un error después de recibirse la respuesta FTMS: %@. Se conserva la respuesta del protocolo."
          }
        }
      }
    },
    "control.lostDuringSpeed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection or FTMS permission was lost while verifying speed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perdió la conexión o el permiso FTMS mientras se verificaba la velocidad."
          }
        }
      }
    },
    "control.lostTargetObservation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FTMS control was lost while verifying the speed target."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perdió el control FTMS al verificar el objetivo de velocidad."
          }
        }
      }
    },
    "control.malformed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Malformed FTMS response; result is uncertain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respuesta FTMS malformada; resultado incierto."
          }
        }
      }
    },
    "control.manualRequiresRunning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A manual target requires a running workout."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El objetivo manual requiere un entrenamiento en marcha."
          }
        }
      }
    },
    "control.noActivePause": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no active workout to pause."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay un entrenamiento activo para pausar."
          }
        }
      }
    },
    "control.noOpenFinish": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no open workout to finish."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay un entrenamiento abierto para finalizar."
          }
        }
      }
    },
    "control.noOpenRecord": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no open record to save."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay un registro abierto para guardar."
          }
        }
      }
    },
    "control.noSegment": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no active automatic segment to skip."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay un segmento automático activo para saltar."
          }
        }
      }
    },
    "control.noSpeedAfterStart": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No recent positive FTMS speed was observed after Start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se observó velocidad FTMS positiva y fresca después de Start."
          }
        }
      }
    },
    "control.noZeroAfterStop": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No recent FTMS speed of 0 km/h was observed after Stop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se observó velocidad FTMS fresca de 0 km/h después de Stop."
          }
        }
      }
    },
    "control.notPaused": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The workout is not paused."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El entrenamiento no está pausado."
          }
        }
      }
    },
    "control.operatorPriority": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The command was interrupted by a higher priority operator action."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La orden fue interrumpida por una acción prioritaria del operador."
          }
        }
      }
    },
    "control.pending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A response is pending or uncertain. Disconnect and prepare a new connection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una respuesta pendiente o incierta. Desconecta y prepara una conexión nueva."
          }
        }
      }
    },
    "control.permission": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The treadmill has not granted FTMS control yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La máquina todavía no concedió control FTMS."
          }
        }
      }
    },
    "control.permissionLost": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The treadmill revoked control permission."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La máquina retiró el permiso de control."
          }
        }
      }
    },
    "control.prepare": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare the control channel. No movement will be sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara el canal de control. No se enviará movimiento."
          }
        }
      }
    },
    "control.procedureBusy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A procedure is already in progress."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya hay un procedimiento en curso."
          }
        }
      }
    },
    "control.rejected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: rejected (code %@). It will not be retried."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: rechazado (código %@). No se reintenta."
          }
        }
      }
    },
    "control.samplesSaveFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving FTMS samples failed: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló el guardado de muestras FTMS: %@"
          }
        }
      }
    },
    "control.selectionPrepared": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A session is already prepared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya hay una sesión preparada."
          }
        }
      }
    },
    "control.selectionPreparing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A session is already being prepared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya se está preparando una sesión."
          }
        }
      }
    },
    "control.speedOutOfRange": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speed is outside the allowed range."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La velocidad está fuera del rango permitido."
          }
        }
      }
    },
    "control.speedRange": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Target is outside the advertised speed range, or no range is available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Objetivo fuera del rango de velocidad anunciado o rango no disponible."
          }
        }
      }
    },
    "control.speedRecent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for a recent nonzero speed reading before changing the target."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera velocidad reciente en movimiento antes de cambiar el objetivo."
          }
        }
      }
    },
    "control.stopNotReady": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth Stop is not ready. Use the physical console."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop Bluetooth no está listo. Usa la consola física."
          }
        }
      }
    },
    "control.stopPending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop is already pending; it will not be resent automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La parada ya está pendiente; no se reenvía automáticamente."
          }
        }
      }
    },
    "control.stopUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth stop is not ready. Use the physical console."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La parada Bluetooth no está preparada. Usa la consola física."
          }
        }
      }
    },
    "control.stopUncertain": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous stop is uncertain. Use the physical console; reconnect before another Bluetooth test."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La parada anterior quedó incierta. Usa la consola física; reconecta antes de otra prueba Bluetooth."
          }
        }
      }
    },
    "control.waiting": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: waiting for a procedure response."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: esperando respuesta del procedimiento."
          }
        }
      }
    },
    "control.writeFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write failed: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escritura fallida: %@"
          }
        }
      }
    },
    "control.zeroFirst": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try Stop first and wait for a recent speed reading of 0 km/h."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba primero Parar y espera una velocidad reciente de 0 km/h."
          }
        }
      }
    },
    "count.interval": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld interval"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld intervals"
                    }
                  }
                }
              }
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld intervalo"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld intervalos"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "diagnostic.detail.default": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See the JSON for evidence of this operation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta el JSON para ver la evidencia de esta operación."
          }
        }
      }
    },
    "error.background.admissionTimedOut": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS did not admit background execution within five seconds. Start was not sent; you can use a free workout."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS no admitió la ejecución en cinco segundos. No se envió el inicio; puedes utilizar el entrenamiento libre."
          }
